# Duke University example. Copy to the toolkit folder as .env and set DOMAIN,
# UPSTREAM, PROTECTED_PATHS and the email addresses.
DOMAIN=myapp.example.org
SP_ENTITY_ID=https://myapp.example.org/shibboleth
SITE_MODE=full
UPSTREAM=http://127.0.0.1:8000
PROTECTED_PATHS="/login"

METADATA_URL=https://shib.oit.duke.edu/duke-metadata-3-signed.xml
METADATA_CERT_URL=https://shib.oit.duke.edu/idp_signing.crt
IDP_ENTITY_ID=https://shib.oit.duke.edu/shibboleth-idp
REGISTRATION_URL=https://authentication.oit.duke.edu/manager/register/sp

# uid is the unscoped NetID. Select the same attributes for your site under
# My Sites at authentication.oit.duke.edu.
ATTRIBUTES="uid eppn mail displayName affiliation"

TLS_MODE=letsencrypt
LETSENCRYPT_EMAIL=you@duke.edu
SUPPORT_EMAIL=you@duke.edu
