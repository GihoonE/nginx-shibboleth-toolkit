# Copy to .env and run: sudo ./install.sh --yes
# Without .env, install.sh asks for each value interactively and writes .env.

# Public host name of this server. It must resolve to this server.
DOMAIN=sso.example.edu

# SP entityID. Changing it after registering with the IdP means registering again.
SP_ENTITY_ID=https://sso.example.edu/shibboleth

# full: write a whole nginx site that proxies to UPSTREAM.
# snippets: only write snippets to include in your own server block.
SITE_MODE=full
UPSTREAM=http://127.0.0.1:8000

# Paths that require a login, space separated. "/" protects the whole site.
PROTECTED_PATHS="/secure"

# Your institution's IdP metadata and the certificate that signs it.
METADATA_URL=https://idp.example.edu/idp/shibboleth
METADATA_CERT_URL=https://idp.example.edu/metadata-signing.crt
# Only when the institution publishes no signing certificate:
# ALLOW_UNSIGNED_METADATA=yes

# Needed only when METADATA_URL lists several IdPs (a federation aggregate).
# IDP_ENTITY_ID=https://idp.example.edu/idp/shibboleth

# Where to register this SP; printed at the end as a reminder.
# REGISTRATION_URL=https://sso.example.edu/register

# Attribute ids from templates/attribute-map.xml, passed as request headers.
ATTRIBUTES="eppn mail displayName affiliation"

# letsencrypt, or existing with TLS_CERT and TLS_KEY. Ignored in snippets mode.
TLS_MODE=letsencrypt
LETSENCRYPT_EMAIL=admin@example.edu
# Required with --yes, after reading https://letsencrypt.org/repository/
# LETSENCRYPT_AGREE_TOS=yes
# TLS_CERT=/etc/ssl/certs/sso.example.edu.fullchain.pem
# TLS_KEY=/etc/ssl/private/sso.example.edu.key

# Contact shown on Shibboleth error pages.
SUPPORT_EMAIL=admin@example.edu
